---
// src/pages/index.astro
// Portfolio Spider-Verse de Juan Diego Delgado Morente
---
<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Juan Diego Delgado | Full-Stack Spider-Verse Portfolio</title>
    <link rel="icon" type="image/svg+xml" href="/portfolioastro1/favicon.svg" />
    
    <!-- Tailwind CSS CDN (is:inline evita que Astro lo bloquee) -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts: Bangers, Space Grotesk, JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bangers&family=JetBrains+Mono:wght@500;700;800&family=Space+Grotesk:wght@400;600;700&display=swap" rel="stylesheet">
    
    <!-- Lucide Icons -->
    <script is:inline src="https://unpkg.com/lucide@latest"></script>

    <script is:inline>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        comic: ['"Bangers"', 'cursive'],
                        sans: ['"Space Grotesk"', 'sans-serif'],
                        mono: ['"JetBrains Mono"', 'monospace'],
                    },
                    colors: {
                        spider: {
                            black: '#09090e',
                            panel: '#12131f',
                            red: '#ff003c',
                            cyan: '#00f0ff',
                            yellow: '#ffe600',
                            magenta: '#ff007f',
                            paper: '#f4f1ea'
                        }
                    }
                }
            }
        }
    </script>

    <style is:global>
        :root {
            --primary-accent: #ff003c;
            --secondary-accent: #00f0ff;
            --highlight: #ffe600;
            --bg-dark: #09090e;
        }

        body.earth-65 {
            --primary-accent: #ff007f;
            --secondary-accent: #00f0ff;
            --highlight: #00f0ff;
            --bg-dark: #0f071e;
        }

        body {
            background-color: var(--bg-dark);
            color: #ffffff;
            overflow-x: hidden;
            transition: background-color 0.4s ease;
        }

        /* Patrón de semitonos de cómic (Halftone) */
        .bg-halftone {
            background-image: radial-gradient(rgba(255, 0, 60, 0.16) 1.5px, transparent 1.5px),
                              radial-gradient(rgba(0, 240, 255, 0.1) 1.5px, var(--bg-dark) 1.5px);
            background-size: 28px 28px;
            background-position: 0 0, 14px 14px;
        }

        .halftone-overlay {
            background-image: radial-gradient(rgba(0, 0, 0, 0.25) 2px, transparent 2px);
            background-size: 8px 8px;
        }

        /* Efecto de Aberración Cromática Spider-Verse */
        .chromatic-text {
            text-shadow: -3px 0px var(--primary-accent), 3px 0px var(--secondary-accent);
            letter-spacing: 0.04em;
        }

        .chromatic-text-sm {
            text-shadow: -1.5px 0px var(--primary-accent), 1.5px 0px var(--secondary-accent);
        }

        /* Animación de Glitch al hacer Hover o cambio de dimensión */
        @keyframes spider-glitch {
            0% { transform: translate(0) skew(0deg); text-shadow: -3px 0 var(--primary-accent), 3px 0 var(--secondary-accent); }
            20% { transform: translate(-3px, 2px) skew(-2deg); text-shadow: 4px -2px var(--primary-accent), -4px 2px var(--highlight); }
            40% { transform: translate(3px, -2px) skew(2deg); text-shadow: -4px 2px var(--secondary-accent), 4px -2px var(--primary-accent); }
            60% { transform: translate(-2px, -1px) skew(0deg); filter: hue-rotate(45deg); }
            80% { transform: translate(2px, 1px) skew(-1deg); filter: hue-rotate(0deg); }
            100% { transform: translate(0) skew(0deg); text-shadow: -3px 0 var(--primary-accent), 3px 0 var(--secondary-accent); }
        }

        .glitch-hover:hover {
            animation: spider-glitch 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94) both infinite;
        }

        .screen-glitch {
            animation: spider-glitch 0.4s steps(2, end) 2;
        }

        /* Viñetas de cómic Neo-Brutalistas (Rojo y Cian con Hover activo en ambas) */
        .comic-panel {
            background: #12131f;
            border: 3px solid #000000;
            box-shadow: 7px 7px 0px #000000, 10px 10px 0px var(--primary-accent);
            transition: all 0.22s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .comic-panel:hover {
            transform: translate(-4px, -4px) rotate(-0.6deg);
            box-shadow: 10px 10px 0px #000000, 14px 14px 0px var(--secondary-accent);
        }

        .comic-panel-cyan {
            background: #12131f;
            border: 3px solid #000000;
            box-shadow: 7px 7px 0px #000000, 10px 10px 0px var(--secondary-accent);
            transition: all 0.22s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .comic-panel-cyan:hover {
            transform: translate(-4px, -4px) rotate(0.6deg);
            box-shadow: 10px 10px 0px #000000, 14px 14px 0px var(--highlight);
        }

        /* Cajas narrativas amarillas clásicas de cómic */
        .comic-caption {
            background-color: #ffe600;
            color: #000000;
            border: 3px solid #000000;
            box-shadow: 4px 4px 0px #000000;
            transform: skew(-4deg);
        }

        /* Botón con Sentido Arácnido */
        .spider-btn {
            position: relative;
            border: 3px solid #000000;
            box-shadow: 5px 5px 0px #000000;
            transition: all 0.18s ease;
        }

        .spider-btn:hover {
            transform: translate(-3px, -3px) scale(1.02);
            box-shadow: 8px 8px 0px var(--secondary-accent);
        }

        .spider-btn:active {
            transform: translate(2px, 2px);
            box-shadow: 2px 2px 0px #000000;
        }

        /* Ondas del Sentido Arácnido que aparecen en Hover */
        .spider-sense-waves {
            opacity: 0;
            transition: opacity 0.2s ease, transform 0.2s ease;
            pointer-events: none;
        }

        .sense-trigger:hover .spider-sense-waves {
            opacity: 1;
            animation: sense-buzz 0.3s infinite alternate;
        }

        @keyframes sense-buzz {
            from { transform: scale(0.96) rotate(-2deg); }
            to { transform: scale(1.04) rotate(2deg); }
        }

        /* Recorte periódico Daily Bugle */
        .bugle-card {
            background: #161826;
            border: 3px solid #000000;
            box-shadow: 6px 6px 0px var(--primary-accent);
            transition: all 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .bugle-card:hover {
            transform: translateY(-6px) rotate(0.5deg);
            box-shadow: 10px 10px 0px var(--highlight);
        }

        /* Animación de entrada al filtrar proyectos */
        @keyframes card-pop {
            0% { opacity: 0; transform: scale(0.94) translateY(10px); }
            100% { opacity: 1; transform: scale(1) translateY(0); }
        }

        .animate-card-pop {
            animation: card-pop 0.25s ease-out forwards;
        }

        /* Scrollbar personalizada */
        ::-webkit-scrollbar {
            width: 10px;
        }
        ::-webkit-scrollbar-track {
            background: #09090e;
        }
        ::-webkit-scrollbar-thumb {
            background: #ff003c;
            border: 2px solid #000;
        }
    </style>
</head>
<body class="bg-halftone font-sans selection:bg-spider-yellow selection:text-black">

    <!-- Fondo de Telaraña SVG Decorativa Fija -->
    <div class="fixed top-0 right-0 w-96 h-96 pointer-events-none opacity-15 z-0 overflow-hidden">
        <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full stroke-cyan-400">
            <path d="M200 0 L0 200 M200 0 L50 200 M200 0 L120 200 M200 0 L0 120 M200 0 L0 50" stroke-width="1.5"></path>
            <path d="M170 0 C170 20 180 30 200 30" stroke-width="1.5"></path>
            <path d="M140 0 C140 40 160 60 200 60" stroke-width="1.5"></path>
            <path d="M100 0 C100 65 135 100 200 100" stroke-width="1.5"></path>
            <path d="M50 0 C50 100 100 150 200 150" stroke-width="1.5"></path>
        </svg>
    </div>

    <!-- Notificación Flotante Estilo Cómic ("¡THWIP!") -->
