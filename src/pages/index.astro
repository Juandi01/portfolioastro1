    <!-- SCRIPT CON DIRECTIVA is:inline PARA QUE FUNCIONE SIEMPRE EN GITHUB PAGES -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            // 1. Inicializar iconos Lucide
            if (window.lucide) {
                window.lucide.createIcons();
            }

            // 2. Función de Notificación Estilo Cómic ("¡THWIP!")
            let toastTimeout;
            function showComicToast(message) {
                const toast = document.getElementById('comic-toast');
                const toastText = document.getElementById('comic-toast-text');
                if (!toast || !toastText) return;

                toastText.textContent = message;
                toast.classList.remove('hidden');
                clearTimeout(toastTimeout);
                toastTimeout = setTimeout(() => {
                    toast.classList.add('hidden');
                }, 3000);
            }

            // 3. Botón Multiverso (Tierra-1610 <-> Tierra-65)
            let isEarth65 = false;
            const dimensionBtn = document.getElementById('dimension-btn');
            if (dimensionBtn) {
                dimensionBtn.addEventListener('click', () => {
                    const body = document.body;
                    const main = document.getElementById('main-container');
                    const badge = document.getElementById('dimension-badge');

                    if (main) {
                        main.classList.add('screen-glitch');
                        setTimeout(() => main.classList.remove('screen-glitch'), 650);
                    }

                    isEarth65 = !isEarth65;
                    if (isEarth65) {
                        body.classList.add('earth-65');
                        if (badge) {
                            badge.textContent = 'EARTH-65 // GWEN NEON MODE';
                            badge.classList.replace('bg-spider-yellow', 'bg-spider-cyan');
                        }
                        showComicToast('¡SALTO DIMENSIONAL A TIERRA-65!');
                    } else {
                        body.classList.remove('earth-65');
                        if (badge) {
                            badge.textContent = 'EARTH-1610 // CÓRDOBA';
                            badge.classList.replace('bg-spider-cyan', 'bg-spider-yellow');
                        }
                        showComicToast('¡REGRESO A TIERRA-1610!');
                    }
                });
            }

            // 4. Botones de Filtro de Proyectos
            const filterButtons = document.querySelectorAll('.filter-btn');
            const projectCards = document.querySelectorAll('.project-card');

            filterButtons.forEach(btn => {
                btn.addEventListener('click', () => {
                    const category = btn.getAttribute('data-filter');

                    // Actualizar estado visual de los botones
                    filterButtons.forEach(b => {
                        if (b.getAttribute('data-filter') === category) {
                            b.classList.remove('bg-spider-panel', 'text-white');
                            b.classList.add('bg-spider-yellow', 'text-black');
                        } else {
                            b.classList.remove('bg-spider-yellow', 'text-black');
                            b.classList.add('bg-spider-panel', 'text-white');
                        }
                    });

                    // Filtrar las tarjetas con animación
                    projectCards.forEach(card => {
                        const cardCat = card.getAttribute('data-category');
                        if (category === 'all' || cardCat === category) {
                            card.style.display = 'flex';
                            card.classList.remove('animate-card-pop');
                            void card.offsetWidth; // Reiniciar animación
                            card.classList.add('animate-card-pop');
                        } else {
                            card.style.display = 'none';
                        }
                    });
                });
            });

            // 5. Botón Copiar Email
            const copyEmailBtn = document.getElementById('copy-email-btn');
            if (copyEmailBtn) {
                copyEmailBtn.addEventListener('click', async () => {
                    const email = 'juandi.dm7@gmail.com';
                    try {
                        await navigator.clipboard.writeText(email);
                        showComicToast('¡Email copiado al portapapeles!');
                    } catch (err) {
                        const tempInput = document.createElement('textarea');
                        tempInput.value = email;
                        document.body.appendChild(tempInput);
                        tempInput.select();
                        document.execCommand('copy');
                        document.body.removeChild(tempInput);
                        showComicToast('¡Email copiado al portapapeles!');
                    }
                });
            }
        });
    </script>
</body>
