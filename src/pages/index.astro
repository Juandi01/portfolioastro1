            <span class="bg-spider-red text-white px-2 py-0.5 border-2 border-black rotate-[-6deg]">¡THWIP!</span>
            <span id="comic-toast-text">¡Copiado al portapapeles!</span>
        </div>
    </div>

    <!-- NAVBAR -->
    <header class="sticky top-0 z-40 backdrop-blur-md bg-[#09090e]/90 border-b-4 border-black">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-3">
            <!-- Logo / Universo -->
            <a href="#inicio" class="flex items-center gap-2.5 group">
                <div class="w-10 h-10 bg-spider-red border-2 border-black flex items-center justify-center shadow-[3px_3px_0px_#00f0ff] group-hover:rotate-12 transition-transform">
                    <svg class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 4a2 2 0 100 4 2 2 0 000-4zm0 5c-2.21 0-4 1.79-4 4v2c0 2.21 1.79 4 4 4s4-1.79 4-4v-2c0-2.21-1.79-4-4-4zm-4.5 1.2L4 7M7.5 13L3 13M7.5 15.8L4 19M16.5 10.2L20 7M16.5 13L21 13M16.5 15.8L20 19" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                    </svg>
                </div>
                <div>
                    <span class="font-comic text-2xl tracking-wider text-white chromatic-text-sm block leading-none">JUANDI DELGADO</span>
                    <span id="dimension-badge" class="font-mono text-[10px] bg-spider-yellow text-black px-1.5 py-0.5 font-extrabold uppercase">EARTH-1610 // CÓRDOBA</span>
                </div>
            </a>

            <!-- Enlaces de Navegación -->
            <nav class="hidden md:flex items-center gap-6 font-mono text-sm font-bold">
                <a href="#sobre-mi" class="hover:text-spider-yellow transition-colors">01.ORIGEN</a>
                <a href="#habilidades" class="hover:text-spider-cyan transition-colors">02.ARSENAL</a>
                <a href="#proyectos" class="hover:text-spider-red transition-colors">03.PROYECTOS</a>
                <a href="#experiencia" class="hover:text-spider-yellow transition-colors">04.MISIONES</a>
                <a href="#contacto" class="hover:text-spider-cyan transition-colors">05.SEÑAL</a>
            </nav>

            <!-- Botón de Cambio de Universo -->
            <div class="flex items-center gap-2.5">
                <button id="dimension-btn" type="button" class="spider-btn bg-spider-panel text-spider-cyan px-3.5 py-1.5 font-mono text-xs font-bold flex items-center gap-1.5 hover:bg-black cursor-pointer" title="Cambiar estilo visual de dimensión">
                    <i data-lucide="sparkles" class="w-4 h-4 text-spider-magenta"></i>
                    <span>Multiverso</span>
                </button>
            </div>
        </div>
    </header>

    <!-- CONTENIDO PRINCIPAL -->
