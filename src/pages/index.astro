---
// src/pages/index.astro
// Portfolio Spider-Verse de Juan Diego Delgado Morente
const proyectos = [
  {
    edicion: "EDICIÓN #01 // FULL-STACK",
    titulo: "ZENPAW 2.0",
    descripcion: "Blog ZenPaw mejorado. Aplicación web completa desarrollada con arquitectura MVC en Symfony y Tailwind CSS.",
    imagen: "/portfolioastro1/proyecto3.png",
    etiqueta: "¡NUEVA VERSIÓN!",
    tecnologias: ["PHP", "Symfony", "Tailwind CSS"],
    repo: "https://github.com/Juandi01/ZenPaw2.0.git",
    categoria: "symfony"
  },
  {
    edicion: "EDICIÓN #02 // AUTOMOCIÓN UI",
    titulo: "LANDING PAGE AUDI",
    descripcion: "Landing page promocional moderna y responsive inspirada en el sector automovilístico de alta gama.",
    imagen: "/portfolioastro1/proyecto4.png",
    etiqueta: "DISEÑO RESPONSIVE",
    tecnologias: ["HTML5", "Tailwind CSS", "JavaScript"],
    repo: "https://github.com/Juandi01/LandingAudi.git",
    categoria: "frontend"
  },
  {
    edicion: "EDICIÓN #03 // ARQUITECTURA WEB",
    titulo: "PROYECTO BLOG CON SYMFONY",
    descripcion: "Diseño responsive creado desde cero aplicando buenas prácticas de accesibilidad web, Tailwind y Symfony.",
    imagen: "/portfolioastro1/proyecto2.png",
    etiqueta: "ACCESIBILIDAD + UI",
    tecnologias: ["PHP", "Symfony", "Tailwind CSS"],
    repo: "https://github.com/Juandi01/Cliente-25-26/tree/main/Cliente%2025-26/Practica4",
    categoria: "symfony"
  },
  {
    edicion: "EDICIÓN #04 // PRODUCTIVIDAD",
    titulo: "GESTOR DE TAREAS",
    descripcion: "Aplicación interactiva de gestión de tareas con manipulación ágil del DOM e interfaz intuitiva.",
    imagen: "/portfolioastro1/proyecto1.png",
    etiqueta: "DOM INTERACTIVO",
    tecnologias: ["HTML5", "CSS3", "JavaScript"],
    repo: "https://github.com/Juandi01/Cliente-25-26/tree/main/Cliente%2025-26/Practica4",
    categoria: "frontend"
  }
];
---
<html lang="es" class="scroll-smooth"><head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Juan Diego Delgado | Full-Stack Spider-Verse Portfolio</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Bangers (Comic Titles), Space Grotesk (Body), JetBrains Mono (Code/Tags) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link href="https://fonts.googleapis.com/css2?family=Bangers&amp;family=JetBrains+Mono:wght@500;700;800&amp;family=Space+Grotesk:wght@400;600;700&amp;display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        comic: ['"Bangers"', 'cursive'],
                        sans: ['"Space Grotesk"', 'sans-serif'],
                        mono: ['"JetBrains Mono"', 'monospace'],
                    },
                    colors: {
                        spider: {
                            black: '#09090e',
                            panel: '#12131f',
                            red: '#ff003c',
                            cyan: '#00f0ff',
                            yellow: '#ffe600',
                            magenta: '#ff007f',
                            paper: '#f4f1ea'
                        }
                    }
                }
            }
        }
    </script>

    <style>
        :root {
            --primary-accent: #ff003c;
            --secondary-accent: #00f0ff;
            --highlight: #ffe600;
            --bg-dark: #09090e;
        }

        body.earth-65 {
            --primary-accent: #ff007f;
            --secondary-accent: #00f0ff;
            --highlight: #00f0ff;
            --bg-dark: #0f071e;
        }

        body {
            background-color: var(--bg-dark);
            color: #ffffff;
            overflow-x: hidden;
            transition: background-color 0.4s ease;
        }

        /* Patrón de semitonos de cómic (Halftone) */
        .bg-halftone {
            background-image: radial-gradient(rgba(255, 0, 60, 0.16) 1.5px, transparent 1.5px),
                              radial-gradient(rgba(0, 240, 255, 0.1) 1.5px, var(--bg-dark) 1.5px);
            background-size: 28px 28px;
            background-position: 0 0, 14px 14px;
        }

        .halftone-overlay {
            background-image: radial-gradient(rgba(0, 0, 0, 0.25) 2px, transparent 2px);
            background-size: 8px 8px;
        }

        /* Efecto de Aberración Cromática Spider-Verse */
        .chromatic-text {
            text-shadow: -3px 0px var(--primary-accent), 3px 0px var(--secondary-accent);
            letter-spacing: 0.04em;
        }

        .chromatic-text-sm {
            text-shadow: -1.5px 0px var(--primary-accent), 1.5px 0px var(--secondary-accent);
        }

        /* Animación de Glitch al hacer Hover o cambio de dimensión */
        @keyframes spider-glitch {
            0% { transform: translate(0) skew(0deg); text-shadow: -3px 0 var(--primary-accent), 3px 0 var(--secondary-accent); }
            20% { transform: translate(-3px, 2px) skew(-2deg); text-shadow: 4px -2px var(--primary-accent), -4px 2px var(--highlight); }
            40% { transform: translate(3px, -2px) skew(2deg); text-shadow: -4px 2px var(--secondary-accent), 4px -2px var(--primary-accent); }
            60% { transform: translate(-2px, -1px) skew(0deg); filter: hue-rotate(45deg); }
            80% { transform: translate(2px, 1px) skew(-1deg); filter: hue-rotate(0deg); }
            100% { transform: translate(0) skew(0deg); text-shadow: -3px 0 var(--primary-accent), 3px 0 var(--secondary-accent); }
        }

        .glitch-hover:hover {
            animation: spider-glitch 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94) both infinite;
        }

        .screen-glitch {
            animation: spider-glitch 0.4s steps(2, end) 2;
        }

        /* Viñetas de cómic Neo-Brutalistas */
        .comic-panel {
            background: #12131f;
            border: 3px solid #000000;
            box-shadow: 7px 7px 0px #000000, 10px 10px 0px var(--primary-accent);
            transition: all 0.22s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .comic-panel:hover {
            transform: translate(-4px, -4px) rotate(-0.6deg);
            box-shadow: 10px 10px 0px #000000, 14px 14px 0px var(--secondary-accent);
        }

        .comic-panel-cyan {
            background: #12131f;
            border: 3px solid #000000;
            box-shadow: 7px 7px 0px #000000, 10px 10px 0px var(--secondary-accent);
            transition: all 0.22s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        /* Cajas narrativas amarillas clásicas de cómic */
        .comic-caption {
            background-color: #ffe600;
            color: #000000;
            border: 3px solid #000000;
            box-shadow: 4px 4px 0px #000000;
            transform: skew(-4deg);
        }

        /* Botón con Sentido Arácnido */
        .spider-btn {
            position: relative;
            border: 3px solid #000000;
            box-shadow: 5px 5px 0px #000000;
            transition: all 0.18s ease;
        }

        .spider-btn:hover {
            transform: translate(-3px, -3px) scale(1.02);
            box-shadow: 8px 8px 0px var(--secondary-accent);
        }

        .spider-btn:active {
            transform: translate(2px, 2px);
            box-shadow: 2px 2px 0px #000000;
        }

        /* Ondas del Sentido Arácnido que aparecen en Hover */
        .spider-sense-waves {
            opacity: 0;
            transition: opacity 0.2s ease, transform 0.2s ease;
            pointer-events: none;
        }

        .sense-trigger:hover .spider-sense-waves {
            opacity: 1;
            animation: sense-buzz 0.3s infinite alternate;
        }

        @keyframes sense-buzz {
            from { transform: scale(0.96) rotate(-2deg); }
            to { transform: scale(1.04) rotate(2deg); }
        }

        /* Recorte periódico Daily Bugle */
        .bugle-card {
            background: #161826;
            border: 3px solid #000000;
            box-shadow: 6px 6px 0px var(--primary-accent);
            transition: all 0.25s ease;
        }

        .bugle-card:hover {
            transform: translateY(-6px) rotate(0.5deg);
            box-shadow: 10px 10px 0px var(--highlight);
        }

        /* Scrollbar personalizada */
        ::-webkit-scrollbar {
            width: 10px;
        }
        ::-webkit-scrollbar-track {
            background: #09090e;
        }
        ::-webkit-scrollbar-thumb {
            background: #ff003c;
            border: 2px solid #000;
        }
    </style>
