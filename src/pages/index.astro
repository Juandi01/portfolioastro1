    <!-- MODAL PARA COPIAR EL CÓDIGO DE ASTRO DIRECTAMENTE A TU PROYECTO -->
    <div id="astro-modal" class="fixed inset-0 z-50 bg-black/85 backdrop-blur-sm hidden items-center justify-center p-4">
        <div class="comic-panel max-w-4xl w-full max-h-[90vh] flex flex-col bg-[#0d0e17] border-4 border-spider-yellow">
            <!-- Cabecera del Modal -->
            <div class="flex items-center justify-between px-6 py-4 bg-black border-b-4 border-black">
                <div class="flex items-center gap-2">
                    <span class="bg-spider-red text-white font-comic text-xl px-2.5 py-0.5 border border-black">ASTRO READY</span>
                    <h3 class="font-mono text-sm sm:text-base font-extrabold text-white">
                        Guía rápida para actualizar tu repositorio `portfolioastro1`
                    </h3>
                </div>
                <button onclick="closeAstroModal()" class="spider-btn bg-spider-red text-white px-3 py-1 font-mono text-xs font-bold">
                    ✕ CERRAR
                </button>
            </div>

            <!-- Contenido del Modal -->
            <div class="p-6 overflow-y-auto space-y-4 font-sans text-sm text-gray-200">
                <div class="bg-black/60 border-l-4 border-spider-cyan p-4 space-y-2">
                    <p class="font-bold text-spider-cyan font-mono text-xs uppercase">¿Cómo pasarlo a tu proyecto de Astro en Ubuntu?</p>
                    <ol class="list-decimal list-inside space-y-1 text-xs sm:text-sm text-gray-300">
                        <li>Tus imágenes actuales (<code class="text-spider-yellow">/portfolioastro1/proyecto1.png</code>, etc.) ya están configuradas en este código.</li>
                        <li>Haz clic en el botón amarillo de abajo para copiar todo el código y pégalo dentro de tu archivo <code class="text-spider-cyan font-mono">src/pages/index.astro</code>.</li>
                        <li>Ejecuta <code class="text-spider-yellow font-mono">npm run dev</code> para previsualizarlo o haz <code class="text-spider-yellow font-mono">git push</code> para actualizar tu GitHub Pages.</li>
                    </ol>
                </div>

                <div class="flex items-center justify-between">
                    <span class="font-mono text-xs text-gray-400">Archivo: <strong class="text-white">src/pages/index.astro</strong></span>
                    <button onclick="copyAstroCode()" class="spider-btn bg-spider-yellow text-black font-mono text-xs font-extrabold px-4 py-2 flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-lucide="Copy" aria-hidden="true" class="lucide lucide-Copy w-4 h-4"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>
                        <span>COPIAR CÓDIGO PARA INDEX.ASTRO</span>
                    </button>
                </div>

                <pre id="astro-code-display" class="bg-black p-4 border-2 border-gray-800 text-xs font-mono text-cyan-300 overflow-x-auto max-h-64 select-all"></pre>
            </div>
        </div>
    </div>

    <script>
        // Inicializar iconos Lucide
        lucide.createIcons();

        // Filtrado de proyectos por categoría
        function filterProjects(category) {
            const cards = document.querySelectorAll('.project-card');
            const buttons = document.querySelectorAll('.filter-btn');

            buttons.forEach(btn => {
                if (btn.dataset.filter === category) {
                    btn.classList.remove('bg-spider-panel', 'text-white');
                    btn.classList.add('bg-spider-yellow', 'text-black');
                } else {
                    btn.classList.remove('bg-spider-yellow', 'text-black');
                    btn.classList.add('bg-spider-panel', 'text-white');
                }
            });

            cards.forEach(card => {
                if (category === 'all' || card.dataset.category === category) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // Cambiar entre Tierra-1610 (Miles Morales) y Tierra-65 (Gwen Stacy)
        let isEarth65 = false;
        function toggleDimension() {
            const body = document.body;
            const main = document.getElementById('main-container');
            const badge = document.getElementById('dimension-badge');

            // Efecto de Glitch en toda la pantalla
            main.classList.add('screen-glitch');
            setTimeout(() => main.classList.remove('screen-glitch'), 650);

            isEarth65 = !isEarth65;
            if (isEarth65) {
                body.classList.add('earth-65');
                badge.textContent = 'EARTH-65 // GWEN NEON MODE';
                badge.classList.replace('bg-spider-yellow', 'bg-spider-cyan');
                showComicToast('¡SALTO DIMENSIONAL A TIERRA-65!');
            } else {
                body.classList.remove('earth-65');
                badge.textContent = 'EARTH-1610 // GRANADA';
                badge.classList.replace('bg-spider-cyan', 'bg-spider-yellow');
                showComicToast('¡REGRESO A TIERRA-1610!');
            }
        }

        // Copiar texto al portapapeles compatible con iFrames
        function copyToClipboard(text, message) {
            const tempInput = document.createElement('textarea');
            tempInput.value = text;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);
            showComicToast(message);
        }

        // Mostrar Notificación Estilo Cómic
        let toastTimeout;
        function showComicToast(message) {
            const toast = document.getElementById('comic-toast');
            const toastText = document.getElementById('comic-toast-text');
            toastText.textContent = message;
            toast.classList.remove('hidden');
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.add('hidden');
            }, 3000);
        }

        // Modal de exportación a Astro
        function openAstroModal() {
            const modal = document.getElementById('astro-modal');
            const codeDisplay = document.getElementById('astro-code-display');
            
            // Generamos la plantilla lista para index.astro con frontmatter de Astro
            const astroTemplate = `---
// src/pages/index.astro
// Portfolio Spider-Verse de Juan Diego Delgado Morente
const proyectos = [
  {
    edicion: "EDICIÓN #01 // FULL-STACK",
    titulo: "ZENPAW 2.0",
    descripcion: "Blog ZenPaw mejorado. Aplicación web completa desarrollada con arquitectura MVC en Symfony y Tailwind CSS.",
    imagen: "/portfolioastro1/proyecto3.png",
    etiqueta: "¡NUEVA VERSIÓN!",
    tecnologias: ["PHP", "Symfony", "Tailwind CSS"],
    repo: "https://github.com/Juandi01/ZenPaw2.0.git",
    categoria: "symfony"
  },
  {
    edicion: "EDICIÓN #02 // AUTOMOCIÓN UI",
    titulo: "LANDING PAGE AUDI",
    descripcion: "Landing page promocional moderna y responsive inspirada en el sector automovilístico de alta gama.",
    imagen: "/portfolioastro1/proyecto4.png",
    etiqueta: "DISEÑO RESPONSIVE",
    tecnologias: ["HTML5", "Tailwind CSS", "JavaScript"],
    repo: "https://github.com/Juandi01/LandingAudi.git",
    categoria: "frontend"
  },
  {
    edicion: "EDICIÓN #03 // ARQUITECTURA WEB",
    titulo: "PROYECTO BLOG CON SYMFONY",
    descripcion: "Diseño responsive creado desde cero aplicando buenas prácticas de accesibilidad web, Tailwind y Symfony.",
    imagen: "/portfolioastro1/proyecto2.png",
    etiqueta: "ACCESIBILIDAD + UI",
    tecnologias: ["PHP", "Symfony", "Tailwind CSS"],
    repo: "https://github.com/Juandi01/Cliente-25-26/tree/main/Cliente%2025-26/Practica4",
    categoria: "symfony"
  },
  {
    edicion: "EDICIÓN #04 // PRODUCTIVIDAD",
    titulo: "GESTOR DE TAREAS",
    descripcion: "Aplicación interactiva de gestión de tareas con manipulación ágil del DOM e interfaz intuitiva.",
    imagen: "/portfolioastro1/proyecto1.png",
    etiqueta: "DOM INTERACTIVO",
    tecnologias: ["HTML5", "CSS3", "JavaScript"],
    repo: "https://github.com/Juandi01/Cliente-25-26/tree/main/Cliente%2025-26/Practica4",
    categoria: "frontend"
  }
];
---
` + document.documentElement.outerHTML;

            codeDisplay.textContent = astroTemplate;
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeAstroModal() {
            const modal = document.getElementById('astro-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function copyAstroCode() {
            const code = document.getElementById('astro-code-display').textContent;
            copyToClipboard(code, '¡Código de index.astro copiado!');
        }
    </script>

</body></html>